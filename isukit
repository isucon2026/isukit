#!/usr/bin/env bash
# isukit — repo-agnostic ISUCON bootstrap + measurement loop.
#
# Design rule: DISCOVER, never assume. Verified against isucon9/10/11/12/13/14
# and private-isu, where the following ALL varied year to year:
#   webapp lang dir name (go | golang | node | nodejs), build tool (Make | Task |
#   neither), compose file presence & naming, systemd unit naming
#   (app.lang.service | app-api-lang.service | one wrapper unit), env file path
#   (/home/isucon/env.sh | /home/isucon/env | none), web server (nginx | Envoy),
#   DB (MySQL | MariaDB | +SQLite), benchmarker target flag (-target | -target-url
#   | -target-host | -target-addr), instance count (3 | 5).
# So: everything is read off the running server via systemd/nginx/mysql at probe
# time. The only thing you type by hand is BENCH_CMD.

set -euo pipefail

KIT_VERSION=1
STATE=".isukit"
CONF="$STATE/config"

# Scripts that run on the host itself live as plain files in remote/, next to
# the real isukit (install.sh puts a symlink to it on PATH, so resolve that).
kit_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd "$(dirname "$src")" && pwd
}

# The kit's code lives in lib/ next to this file (install.sh clones the whole
# repo and puts a symlink to this file on PATH; kit_dir resolves that link).
ISUKIT_LIB="$(kit_dir)/lib"
# shellcheck source=lib/core.sh
. "$ISUKIT_LIB/core.sh"
# shellcheck source=lib/hosts.sh
. "$ISUKIT_LIB/hosts.sh"
# shellcheck source=lib/probe.sh
. "$ISUKIT_LIB/probe.sh"
# shellcheck source=lib/logs.sh
. "$ISUKIT_LIB/logs.sh"
# shellcheck source=lib/etc.sh
. "$ISUKIT_LIB/etc.sh"
# shellcheck source=lib/runs.sh
. "$ISUKIT_LIB/runs.sh"
# shellcheck source=lib/analyze.sh
. "$ISUKIT_LIB/analyze.sh"
# shellcheck source=lib/deploy.sh
. "$ISUKIT_LIB/deploy.sh"
# shellcheck source=lib/repo.sh
. "$ISUKIT_LIB/repo.sh"
# shellcheck source=lib/go.sh
. "$ISUKIT_LIB/go.sh"
# shellcheck source=lib/doctor.sh
. "$ISUKIT_LIB/doctor.sh"
# shellcheck source=lib/final.sh
. "$ISUKIT_LIB/final.sh"
# shellcheck source=lib/env.sh
. "$ISUKIT_LIB/env.sh"
# shellcheck source=lib/team.sh
. "$ISUKIT_LIB/team.sh"

usage() { cat >&2 <<'EOF'
isukit — repo-agnostic ISUCON bootstrap + measurement loop

  ONE COMMAND
    isukit go <repo-url> <app-host> [bench-host] [-i keyfile] [-p port] [--ssh-opts 'raw']
                                         clone, probe, install tools, enable logs
    isukit go --new <owner/repo> <app-host> [bench-host] [-i keyfile] [--invite u1,u2]
                                         no team repo yet (T+0): copy the server's
                                         webapp here, commit it as the baseline,
                                         create the private repo with gh and push,
                                         put nginx/mysql/unit config under git
                                         (etc adopt) + each host's env file as a
                                         second baseline commit, then go on as go.
                                         GitHub credentials never leave the laptop
                                         -i/-p write .isukit/ssh_config (aliases
                                         isukit-app/isukit-bench) and set SSH_OPTS
                                         to '-F .isukit/ssh_config' for you — solves
                                         the ssh -p / scp -P mismatch below
                                         -i also takes: -iKEY, -i=KEY, --identity KEY,
                                         --identity=KEY, --key KEY, --key=KEY; -p also
                                         takes --port N / --port=N; --debug-args prints
                                         the raw argv it received and exits

  SETUP
    isukit init <repo-url> [dir]        clone + create .isukit/
    isukit host {app|bench} <target> [ssh opts...]   ssh target, or 'local'
                                         ssh opts go into SSH_OPTS (config), e.g.
                                         '-F ./ssh_config' or '-i ~/key.pem -p 2222'
                                         note: scp needs -P for port, not -p — if you
                                         hand-edit SSH_OPTS for a custom port, check both
    isukit host add <target>            add another app instance (EXTRA_HOSTS, or an
                                         'app' line in .isukit/hosts once that exists)
    isukit host role <target> <roles>   give a host its roles, comma-separated:
                                         app (deploy/restart/pprof), web (nginx logs,
                                         alp), db (slow log, slow). writes .isukit/hosts
    isukit hosts                        list hosts, their roles and the units each
                                         must run
    isukit probe                        interrogate the server, write .isukit/manifest,
                                         then auto-probe + compose BENCH_CMD (see below)
    isukit benchprobe                   (re-)probe the benchmarker binary on $BENCH and
                                         compose BENCH_CMD from its own --help output
    isukit benchcmd ['<command>']       set BENCH_CMD by hand; no arg prints current value
    isukit benchmode [auto|manual]      auto = ssh BENCH_CMD on $BENCH; manual = the
                                         portal runs the bench, you paste the score;
                                         no arg prints the current mode
    isukit unit <systemd-unit-name>     override the auto-detected app unit, re-probe
    isukit setup                        install alp + pt-query-digest on the app host

  LOOP
    isukit logs {on|off}                nginx LTSV + mysql slow log (off for scoring runs)
    isukit etc adopt [/etc/path...]     put nginx/mysql/app-unit config under git: move
                                         each file to <server repo>/etc/<same path>,
                                         symlink /etc to it (backup: /etc/isukit-orig/),
                                         verify nginx -t / mysql restart, roll back a
                                         tier that fails, then pull etc/ down locally.
                                         no args = discover; handles AppArmor for mysqld
    isukit etc status                   which repo etc/ files /etc actually reads
    isukit etc push                     local etc/ -> server, reload/restart only the
                                         tiers that changed (deploy does this too once
                                         /etc is linked)
    isukit etc pull                     server etc/ -> local etc/ (isukit's own logging
                                         edits stripped)
    isukit env status|pull|push         each host's env file (DB_HOST, ...) as
                                         hosts/<host>/<file> in the repo: push writes
                                         changed ones to their host and restarts the
                                         app there (deploy pushes them too); pull
                                         never overwrites an unsaved local edit
    isukit bench [note] [--score N] [--fail]
                                         auto mode: run BENCH_CMD, record score+sha;
                                         while logs are on it also empties the logs,
                                         samples every host each second, takes a
                                         pprof during the load and saves it all to
                                         .isukit/runs/<when>/ (isukit show)
                                         manual mode: no ssh — prints portal instructions;
                                         --score N (or a paste prompt) supplies the score,
                                         --fail records FAIL for an errored run
    isukit show [n | when]              a saved run: per-host CPU and top processes
                                         while the load was on, alp, slow, pprof.
                                         1 = latest (default), 2 = the one before.
                                         bench saves these while logs are on
    isukit alp [--patterns]             top endpoints by SUMMED response time.
                                         URIs are grouped by regexes derived from
                                         the log (ids, high fan-out segments);
                                         --patterns prints them. ALP_MATCHES in the
                                         config replaces them with your own
    isukit slow                         top queries by total time
    isukit pprof [sec] [port]           pull a Go CPU profile
    isukit deploy [--force]             rsync source up, build/compose, restart
                                         --force skips the "does this look like a
                                         built binary under /home/isucon" safety check
    isukit restart                      restart APP_UNIT (+ EXTRA_UNITS) on every
                                         host with role app
    isukit score                        run history: every run, with branch and who

  DIAGNOSE
    isukit os                           uptime, vmstat/iostat/mpstat, free, df, unit
                                         status on $APP — tolerates missing tools
    isukit doctor                       non-destructive check + auto-repair of config,
                                         connectivity, manifest, unit health, tools,
                                         logging state, disk headroom, bench mode
    isukit attribute [noise_pct] [--last2]
                                         the latest run vs the latest run deployed from
                                         main (everyone's runs); KEEP / REVERT /
                                         INCONCLUSIVE vs noise_pct (default 10).
                                         --last2: the last two runs, whatever they were

  SHIP
    isukit ship [--no-check] "<message>"
                                         go build + go vet first, then commit everything
                                         on a new isukit/<slug> branch, push, open a
                                         draft PR (gh, if on PATH)
    isukit revert [<sha>]                git revert; no arg reverts the most recent
                                         commit on an isukit/* branch reachable from HEAD

  ENDGAME
    isukit final check                  list everything that still logs or measures and
                                         costs score: nginx access_log (on as handed
                                         out), slow / general log (live and in .cnf),
                                         sysstat collectors, isukit leftovers, app log
                                         volume, and in the app's Go code: pprof, request
                                         loggers, debug switches. changes nothing
    isukit final apply                  logs off, access_log off + mysql logs off via
                                         etc/ (a diff you can revert), etc push, clean
                                         the hosts, check again. app code is reported,
                                         not edited — fix it, deploy, bench, then ship
    isukit finalize                     logs off -> reboot ALL hosts -> verify units ->
                                         verify HTTP (web hosts via nginx, app hosts
                                         directly; FINAL_CHECK_PATH, default /) -> score
                                         (restart order across hosts is not guaranteed)

  TEAM (one set of servers, several people)
    isukit lock [status]                take the servers for your turn: deploy, bench,
                                         etc / env push, logs, final, finalize by anyone
                                         else stop with "busy — <who>: <what> for Nm".
                                         those commands also lock for their own run
    isukit unlock [--force]             hand the servers back (--force: someone else's)
                                         deploy refuses uncommitted changes and branches
                                         without origin/main (--force overrides) and
                                         records sha / branch / who on the server; bench
                                         records that, and publishes each run to the
                                         isukit-runs branch so score / show / attribute
                                         see everyone's runs

  VERSION
    isukit version                      the kit's version and git tag/sha — check
                                         everyone runs the frozen contest tag

  CONFIG (.isukit/config)
    SSH_OPTS       extra ssh/scp flags applied to every remote call
    EXTRA_UNITS    space-separated extra units 'restart'/'finalize' also restart
    EXTRA_HOSTS    space-separated extra app instances (used until .isukit/hosts exists)
    BENCH_MODE     auto (ssh + BENCH_CMD) or manual (portal, paste the score)
    ALP_MATCHES    comma-separated alp -m regexes to use instead of derived ones;
                   ALP_THRESH (20) = fan-out at which a path segment becomes a group
    FINAL_CHECK_PATH  path finalize requests after the reboot (default /); pick one that
                   touches the DB. FINAL_APP_PORT if the app's port is not discoverable
    PPROF_PORT     pprof listener on app hosts (default 6060); PPROF_SEC (30) and
                   PPROF_DELAY (5) shape the profile bench takes during the load
    isukit.conf    (repo root, committed) team-wide settings, read before .isukit/config
                   so a laptop can still override: FINAL_CHECK_PATH, ALP_MATCHES, ...
    isukit.hosts   (repo root, committed) the roles, so every laptop targets the same
                   boxes; an older .isukit/hosts moves there on the next host role
    ETC_REPO       server dir whose etc/ holds linked configs (default: git root of
                   the probed SRC_DIR, else SRC_DIR)

  App-unit auto-detection is a scored heuristic, not certain — it can pick wrong
  on unusual layouts. 'isukit probe' prints APP_CANDIDATES and warns on low
  confidence; sanity-check it there, and fix it with 'isukit unit <name>'.
EOF
exit "${1:-1}"; }

main() {
  local __a __norm __t __changed=0
  local -a __new=()
  set -f
  for __a in "$@"; do
    __norm=$(normalize_ws_arg "$__a")
    if [ "$__norm" = "$__a" ]; then
      __new+=("$__norm")
    else
      __changed=1
      for __t in $__norm; do __new+=("$__t"); done
    fi
  done
  set +f
  [ "$__changed" = "1" ] && warn "cleaned invisible whitespace (non-breaking / full-width / zero-width space, or a BOM) out of the arguments — your paste was mangled"
  if [ "${#__new[@]}" -gt 0 ]; then set -- "${__new[@]}"; else set --; fi

  local c="${1:-}"; shift || true
  case "$c" in
    go)       cmd_go "$@" ;;
    init)     cmd_init "$@" ;;
    host)     cmd_host "$@" ;;
    hosts)    cmd_hosts ;;
    probe)    cmd_probe ;;
    benchprobe) cmd_benchprobe ;;
    benchcmd) cmd_benchcmd "$@" ;;
    benchmode) cmd_benchmode "$@" ;;
    unit)     cmd_unit "$@" ;;
    setup)    cmd_setup ;;
    logs)     cmd_logs "$@" ;;
    etc)      cmd_etc "$@" ;;
    env)      cmd_env "$@" ;;
    lock)     cmd_lock "$@" ;;
    unlock)   cmd_unlock "$@" ;;
    bench)    cmd_bench "$@" ;;
    score)    cmd_score ;;
    show)     cmd_show "$@" ;;
    alp)      cmd_alp "$@" ;;
    slow)     cmd_slow ;;
    pprof)    cmd_pprof "$@" ;;
    os)       cmd_os ;;
    doctor)   cmd_doctor ;;
    attribute) cmd_attribute "$@" ;;
    ship)     cmd_ship "$@" ;;
    revert)   cmd_revert "$@" ;;
    deploy)   cmd_deploy "$@" ;;
    restart)  cmd_restart ;;
    final)    cmd_final "$@" ;;
    finalize) cmd_finalize ;;
    version|--version) cmd_version ;;
    help|--help|-h) usage 0 ;;
    *)        usage ;;
  esac
}
# tests source this file to reach the functions without running a command
[ "${ISUKIT_SOURCED:-0}" = 1 ] || main "$@"
