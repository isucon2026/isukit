[Unit]
Description=ISUTRAIN (Language go)
Requires=docker.service
[Service]
EnvironmentFile=-/home/isucon/isutrain/webapp/.env
Environment="PAYMENT_API=https://payment.example.isucon9.local"
WorkingDirectory=/home/isucon/isutrain/webapp
Type=simple
ExecStartPre=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.go.yml build
ExecStart=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.go.yml up
ExecStop=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.go.yml stop
ExecReload=/usr/bin/docker-compose -f docker-compose.yml -f docker-compose.go.yml restart webapp
Restart=always
RestartSec=10s
[Install]
WantedBy=multi-user.target
