[Unit]
Description=PostgreSQL RDBMS
After=network.target

[Service]
Type=forking
User=postgres
ExecStart=/usr/lib/postgresql/9.4/bin/pg_ctl start -D /var/lib/postgresql/9.4/main -s -o "-c config_file=/etc/postgresql/9.4/main/postgresql.conf"
ExecStop=/usr/lib/postgresql/9.4/bin/pg_ctl stop -D /var/lib/postgresql/9.4/main -s -m fast

[Install]
WantedBy=multi-user.target
